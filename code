<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Who Gets to See Themselves?</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Caveat:wght@500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --cream: #FFF8EE;
      --paper: #FFFFFF;
      --ink: #202124;

      --orange: #E76F51;
      --blue: #3155D9;
      --green: #5E9F6E;
      --pink: #E982A6;
      --purple: #8667C8;
      --yellow: #F3C969;

      --border: #202124;
      --muted: #686868;
      --shadow: 6px 6px 0 var(--ink);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--cream);
      color: var(--ink);
      font-family: "DM Sans", sans-serif;
      line-height: 1.5;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    select,
    input {
      font: inherit;
    }

    /* =========================
       NAVIGATION
    ========================= */

    nav {
      position: sticky;
      top: 0;
      z-index: 1000;

      display: flex;
      justify-content: space-between;
      align-items: center;

      padding: 18px 5%;

      background: rgba(255, 248, 238, 0.94);
      backdrop-filter: blur(12px);

      border-bottom: 2px solid var(--ink);
    }

    .logo {
      font-family: "Space Grotesk", sans-serif;
      font-weight: 700;
      font-size: 1.15rem;
      letter-spacing: -0.04em;
    }

    .logo span {
      color: var(--orange);
    }

    .nav-links {
      display: flex;
      gap: 28px;
      align-items: center;
    }

    .nav-links a {
      font-size: 0.9rem;
      font-weight: 600;
    }

    .nav-links a:hover {
      color: var(--orange);
    }

    .menu-button {
      display: none;
      border: 2px solid var(--ink);
      background: var(--paper);
      padding: 7px 10px;
      border-radius: 10px;
      cursor: pointer;
    }

    /* =========================
       GENERAL
    ========================= */

    section {
      padding: 100px 7%;
    }

    .section-number {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 18px;
      color: var(--orange);
    }

    .section-title {
      font-family: "Space Grotesk", sans-serif;
      font-size: clamp(2.5rem, 6vw, 5.5rem);
      line-height: 0.95;
      letter-spacing: -0.065em;
      max-width: 900px;
      margin-bottom: 25px;
    }

    .section-description {
      max-width: 700px;
      color: var(--muted);
      font-size: 1.05rem;
    }

    /* =========================
       HERO
    ========================= */

    .hero {
      min-height: 88vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      padding-top: 80px;
    }

    .hero-content {
      max-width: 900px;
      position: relative;
      z-index: 2;
    }

    .hero-eyebrow {
      display: inline-block;
      background: var(--yellow);
      border: 2px solid var(--ink);
      padding: 7px 14px;
      border-radius: 50px;
      font-size: 0.82rem;
      font-weight: 700;
      margin-bottom: 28px;
      transform: rotate(-2deg);
    }

    .hero h1 {
      font-family: "Space Grotesk", sans-serif;
      font-size: clamp(4rem, 10vw, 9.5rem);
      line-height: 0.82;
      letter-spacing: -0.08em;
      max-width: 1050px;
    }

    .hero h1 span {
      color: var(--orange);
    }

    .hero-subtitle {
      max-width: 650px;
      margin-top: 35px;
      font-size: clamp(1rem, 2vw, 1.3rem);
      color: #505050;
    }

    .hero-buttons {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      margin-top: 35px;
    }

    .button {
      display: inline-block;
      border: 2px solid var(--ink);
      padding: 13px 21px;
      border-radius: 50px;
      font-weight: 700;
      cursor: pointer;
      transition: 0.2s ease;
      background: var(--paper);
    }

    .button:hover {
      transform: translate(-3px, -3px);
      box-shadow: 4px 4px 0 var(--ink);
    }

    .button.primary {
      background: var(--orange);
    }

    /* floating archive pieces */

    .floating-note {
      position: absolute;
      border: 2px solid var(--ink);
      padding: 14px 18px;
      background: var(--paper);
      box-shadow: 4px 4px 0 var(--ink);
      font-family: "Caveat", cursive;
      font-size: 1.25rem;
      z-index: 1;
    }

    .note-one {
      right: 9%;
      top: 17%;
      transform: rotate(8deg);
      background: var(--pink);
    }

    .note-two {
      right: 16%;
      bottom: 15%;
      transform: rotate(-6deg);
      background: var(--green);
    }

    .note-three {
      right: 3%;
      top: 50%;
      transform: rotate(4deg);
      background: var(--purple);
      color: white;
    }

    /* =========================
       INTRO
    ========================= */

    .intro {
      background: var(--ink);
      color: white;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 70px;
      align-items: center;
    }

    .intro .section-number {
      color: var(--yellow);
    }

    .intro h2 {
      font-family: "Space Grotesk";
      font-size: clamp(2.5rem, 5vw, 5rem);
      line-height: 0.95;
      letter-spacing: -0.06em;
    }

    .intro-text {
      font-size: 1.1rem;
      color: #d6d6d6;
    }

    .intro-text p {
      margin-bottom: 20px;
    }

    /* =========================
       ARCHIVE EXPLORER
    ========================= */

    .explorer {
      background: var(--cream);
    }

    .filter-box {
      margin-top: 45px;
      padding: 30px;
      background: var(--paper);
      border: 2px solid var(--ink);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .filter-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 15px;
    }

    .filter-grid select {
      width: 100%;
      padding: 13px;
      border: 2px solid var(--ink);
      border-radius: 10px;
      background: var(--cream);
      cursor: pointer;
    }

    .search-box {
      margin-top: 20px;
      width: 100%;
      padding: 15px 18px;
      border: 2px solid var(--ink);
      border-radius: 10px;
      background: var(--cream);
      outline: none;
    }

    .archive-count {
      margin-top: 20px;
      font-weight: 700;
    }

    /* =========================
       TEXT CARDS
    ========================= */

    .text-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
      margin-top: 45px;
    }

    .text-card {
      background: var(--paper);
      border: 2px solid var(--ink);
      border-radius: var(--radius);
      padding: 25px;
      min-height: 280px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: 0.25s ease;
      box-shadow: 4px 4px 0 var(--ink);
    }

    .text-card:hover {
      transform: translateY(-8px) rotate(-1deg);
    }

    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
    }

    .tag {
      display: inline-block;
      border: 1.5px solid var(--ink);
      border-radius: 50px;
      padding: 4px 9px;
      font-size: 0.72rem;
      font-weight: 700;
      background: var(--yellow);
    }

    .card-number {
      font-size: 0.8rem;
      color: var(--muted);
    }

    .text-card h3 {
      font-family: "Space Grotesk";
      font-size: 1.7rem;
      line-height: 1;
      margin: 35px 0 15px;
    }

    .text-card p {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 18px;
    }

    .small-tag {
      font-size: 0.72rem;
      padding: 5px 8px;
      border-radius: 5px;
      background: #eee;
    }

    .read-link {
      margin-top: 25px;
      font-weight: 700;
    }

    /* =========================
       THEMES
    ========================= */

    .themes {
      background: var(--paper);
    }

    .theme-grid {
      margin-top: 50px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
    }

    .theme {
      min-height: 180px;
      padding: 25px;
      border: 2px solid var(--ink);
      border-radius: var(--radius);
      display: flex;
      align-items: flex-end;
      font-family: "Space Grotesk";
      font-size: 1.5rem;
      font-weight: 700;
      line-height: 1;
      transition: 0.2s;
      cursor: pointer;
      box-shadow: 4px 4px 0 var(--ink);
    }

    .theme:hover {
      transform: translateY(-6px);
    }

    .theme:nth-child(1) {
      background: var(--pink);
    }

    .theme:nth-child(2) {
      background: var(--orange);
    }

    .theme:nth-child(3) {
      background: var(--blue);
      color: white;
    }

    .theme:nth-child(4) {
      background: var(--green);
    }

    .theme:nth-child(5) {
      background: var(--purple);
      color: white;
    }

    .theme:nth-child(6) {
      background: var(--yellow);
    }

    .theme:nth-child(7) {
      background: #D7E6F5;
    }

    .theme:nth-child(8) {
      background: #F2D8CE;
    }

    /* =========================
       WHO IS SEEN
    ========================= */

    .seen {
      background: var(--orange);
      position: relative;
      overflow: hidden;
    }

    .seen .section-number {
      color: var(--ink);
    }

    .seen h2 {
      font-family: "Space Grotesk";
      font-size: clamp(3rem, 8vw, 8rem);
      line-height: 0.82;
      letter-spacing: -0.08em;
      max-width: 1000px;
    }

    .seen h2 span {
      color: white;
    }

    .seen-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 25px;
      margin-top: 60px;
    }

    .seen-card {
      background: var(--paper);
      border: 2px solid var(--ink);
      border-radius: var(--radius);
      padding: 35px;
      box-shadow: var(--shadow);
    }

    .seen-card h3 {
      font-family: "Space Grotesk";
      font-size: 2rem;
      margin-bottom: 20px;
    }

    .seen-card ul {
      list-style: none;
    }

    .seen-card li {
      border-bottom: 1px solid #ddd;
      padding: 10px 0;
    }

    /* =========================
       MAP
    ========================= */

    .map-section {
      background: var(--cream);
    }

    .map-container {
      margin-top: 50px;
      min-height: 400px;
      border: 2px solid var(--ink);
      border-radius: var(--radius);
      background: var(--paper);
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    .india-placeholder {
      font-family: "Space Grotesk";
      font-size: clamp(5rem, 15vw, 13rem);
      font-weight: 700;
      color: var(--orange);
      opacity: 0.85;
      letter-spacing: -0.1em;
    }

    .map-note {
      position: absolute;
      background: var(--yellow);
      border: 2px solid var(--ink);
      padding: 15px;
      border-radius: 12px;
      font-weight: 700;
      transform: rotate(-5deg);
      top: 25px;
      right: 25px;
    }

    /* =========================
       FEATURED QUESTION
    ========================= */

    .question {
      background: var(--purple);
      color: white;
      text-align: center;
    }

    .question h2 {
      font-family: "Space Grotesk";
      font-size: clamp(3rem, 7vw, 7rem);
      line-height: 0.9;
      letter-spacing: -0.07em;
      max-width: 1000px;
      margin: auto;
    }

    .question p {
      max-width: 650px;
      margin: 35px auto 0;
      font-size: 1.1rem;
      color: #f2edff;
    }

    /* =========================
       FROM THE ARCHIVE
    ========================= */

    .stories {
      background: var(--paper);
    }

    .story-grid {
      display: grid;
      grid-template-columns: 1.3fr 1fr 1fr;
      gap: 20px;
      margin-top: 50px;
    }

    .story {
      border: 2px solid var(--ink);
      border-radius: var(--radius);
      padding: 30px;
      min-height: 300px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background: var(--cream);
      box-shadow: 4px 4px 0 var(--ink);
    }

    .story:first-child {
      background: var(--yellow);
    }

    .story h3 {
      font-family: "Space Grotesk";
      font-size: 2rem;
      line-height: 1;
    }

    .story small {
      font-weight: 700;
    }

    /* =========================
       FOOTER
    ========================= */

    footer {
      background: var(--ink);
      color: white;
      padding: 70px 7% 35px;
    }

    .footer-top {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 60px;
    }

    footer h3 {
      font-family: "Space Grotesk";
      font-size: 2rem;
      margin-bottom: 15px;
    }

    footer p {
      color: #bdbdbd;
      max-width: 500px;
    }

    footer h4 {
      margin-bottom: 15px;
    }

    footer ul {
      list-style: none;
    }

    footer li {
      margin: 8px 0;
      color: #cfcfcf;
    }

    .copyright {
      border-top: 1px solid #444;
      margin-top: 60px;
      padding-top: 20px;
      color: #888;
      font-size: 0.8rem;
    }

    /* =========================
       RESPONSIVE
    ========================= */

    @media (max-width: 900px) {

      .nav-links {
        display: none;
        position: absolute;
        top: 70px;
        left: 0;
        right: 0;
        padding: 25px;
        background: var(--cream);
        border-bottom: 2px solid var(--ink);
        flex-direction: column;
        align-items: flex-start;
      }

      .nav-links.active {
        display: flex;
      }

      .menu-button {
        display: block;
      }

      section {
        padding: 75px 6%;
      }

      .hero {
        min-height: 80vh;
      }

      .floating-note {
        display: none;
      }

      .intro,
      .seen-grid {
        grid-template-columns: 1fr;
      }

      .filter-grid {
        grid-template-columns: 1fr 1fr;
      }

      .text-grid {
        grid-template-columns: 1fr 1fr;
      }

      .theme-grid {
        grid-template-columns: 1fr 1fr;
      }

      .story-grid {
        grid-template-columns: 1fr;
      }

      .footer-top {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {

      .hero h1 {
        font-size: 4rem;
      }

      .filter-grid {
        grid-template-columns: 1fr;
      }

      .text-grid {
        grid-template-columns: 1fr;
      }

      .theme-grid {
        grid-template-columns: 1fr;
      }

      .theme {
        min-height: 140px;
      }

      .hero-buttons {
        flex-direction: column;
        align-items: flex-start;
      }

      .button {
        width: 100%;
        text-align: center;
      }
    }
  </style>
</head>


<body>

  <!-- =========================
       NAVIGATION
  ========================== -->

  <nav>

    <a href="#home" class="logo">
      THE <span>ARCHIVE</span>
    </a>

    <div class="nav-links" id="navLinks">
      <a href="#explore">Explore</a>
      <a href="#themes">Themes</a>
      <a href="#map">Map</a>
      <a href="#seen">Who Is Seen?</a>
      <a href="#about">About</a>
    </div>

    <button class="menu-button" onclick="toggleMenu()">
      ☰
    </button>

  </nav>


  <!-- =========================
       HERO
  ========================== -->

  <section class="hero" id="home">

    <div class="hero-content">

      <div class="hero-eyebrow">
        AN ARCHIVE OF SCHOOL TEXTS IN INDIA
      </div>

      <h1>
        WHO GETS TO
        <span>SEE THEMSELVES?</span>
      </h1>

      <p class="hero-subtitle">
        An archive exploring the texts taught to students in Classes
        8–10 across India's languages, states and school boards —
        and asking who gets represented, who gets left out, and
        what futures young readers are invited to imagine.
      </p>

      <div class="hero-buttons">

        <a href="#explore" class="button primary">
          Explore the Archive →
        </a>

        <a href="#about" class="button">
          Understand the Project
        </a>

      </div>

    </div>


    <div class="floating-note note-one">
      WHO IS HERE?
    </div>

    <div class="floating-note note-two">
      LOOK CLOSER.
    </div>

    <div class="floating-note note-three">
      DID YOU NOTICE?
    </div>

  </section>


  <!-- =========================
       ABOUT / INTRO
  ========================== -->

  <section class="intro" id="about">

    <div>

      <div class="section-number">
        01 — The Archive
      </div>

      <h2>
        Reading the texts that teach India to its children.
      </h2>

    </div>

    <div class="intro-text">

      <p>
        School texts do more than teach language and literature.
        They introduce young readers to people, places, families,
        occupations, identities and ideas about the future.
      </p>

      <p>
        This archive brings together texts taught in Classes 8–10
        across different Indian states, boards and languages.
      </p>

      <p>
        We ask a simple but important question:
        <strong>what happens when a child looks inside a textbook
        and does — or does not — see a version of themselves?</strong>
      </p>

    </div>

  </section>


  <!-- =========================
       EXPLORE
  ========================== -->

  <section class="explorer" id="explore">

    <div class="section-number">
      02 — Explore
    </div>

    <h2 class="section-title">
      Find a text.
      Follow a theme.
      Ask a question.
    </h2>

    <p class="section-description">
      Explore the archive by class, board, language, state,
      subject or theme.
    </p>


    <div class="filter-box">

      <div class="filter-grid">

        <select>
          <option>Class</option>
          <option>Class 8</option>
          <option>Class 9</option>
          <option>Class 10</option>
        </select>

        <select>
          <option>Board</option>
          <option>CBSE</option>
          <option>ICSE</option>
          <option>State Board</option>
        </select>

        <select>
          <option>Language</option>
          <option>English</option>
          <option>Hindi</option>
          <option>Telugu</option>
          <option>Tamil</option>
          <option>Odia</option>
        </select>

        <select>
          <option>Subject</option>
          <option>English</option>
          <option>Hindi</option>
          <option>Social Science</option>
          <option>Literature</option>
        </select>

        <select>
          <option>State</option>
          <option>Telangana</option>
          <option>Odisha</option>
          <option>Jharkhand</option>
          <option>Madhya Pradesh</option>
        </select>

      </div>

      <input
        class="search-box"
        type="text"
        id="searchInput"
        placeholder="Search the archive — try 'childhood', 'work', 'gender'..."
        onkeyup="searchTexts()"
      >

      <div class="archive-count">
        Showing <span id="resultCount">6</span> texts
      </div>

    </div>


    <!-- TEXT CARDS -->

    <div class="text-grid" id="textGrid">

      <article class="text-card" data-search="childhood family class 8 english">

        <div>

          <div class="card-top">

            <span class="tag">
              CLASS 8
            </span>

            <span class="card-number">
              #001
            </span>

          </div>

          <h3>
            A Story of Childhood
          </h3>

          <p>
            A narrative exploring childhood, family and
            growing up.
          </p>

          <div class="tags">
            <span class="small-tag">Childhood</span>
            <span class="small-tag">Family</span>
            <span class="small-tag">Identity</span>
          </div>

        </div>

        <div class="read-link">
          Explore text →
        </div>

      </article>


      <article class="text-card" data-search="work labour class 9 english">

        <div>

          <div class="card-top">

            <span class="tag" style="background:#E76F51;">
              CLASS 9
            </span>

            <span class="card-number">
              #002
            </span>

          </div>

          <h3>
            Work & Labour
          </h3>

          <p>
            How work, occupation and labour appear
            in school narratives.
          </p>

          <div class="tags">
            <span class="small-tag">Labour</span>
            <span class="small-tag">Class</span>
            <span class="small-tag">Poverty</span>
          </div>

        </div>

        <div class="read-link">
          Explore text →
        </div>

      </article>


      <article class="text-card" data-search="gender women class 10 hindi">

        <div>

          <div class="card-top">

            <span class="tag" style="background:#E982A6;">
              CLASS 10
            </span>

            <span class="card-number">
              #003
            </span>

          </div>

          <h3>
            Women & Gender
          </h3>

          <p>
            Looking at the roles, identities and
            experiences given to women.
          </p>

          <div class="tags">
            <span class="small-tag">Gender</span>
            <span class="small-tag">Identity</span>
          </div>

        </div>

        <div class="read-link">
          Explore text →
        </div>

      </article>


      <article class="text-card" data-search="village rural place class 9 english">

        <div>

          <div class="card-top">

            <span class="tag" style="background:#5E9F6E;">
              CLASS 9
            </span>

            <span class="card-number">
              #004
            </span>

          </div>

          <h3>
            Village / City
          </h3>

          <p>
            How geography shapes the worlds presented
            to young readers.
          </p>

          <div class="tags">
            <span class="small-tag">Place</span>
            <span class="small-tag">Rural</span>
            <span class="small-tag">Urban</span>
